# Database
DATABASE_URL="postgresql://user:password@localhost:5432/masterguitar?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# App (public URL, required in production: Stripe success/cancel redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe account of each prof (s19): 32-byte key, base64. Encrypts the profs' Stripe keys and
# webhook secrets (AES-256-GCM). Generate with:  openssl rand -base64 32
# Never commit the real value, never store it in the database, never expose it to the client.
STRIPE_KEYS_ENCRYPTION_KEY=""
